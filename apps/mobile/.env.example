# Copie para .env na pasta apps/mobile (mesmo nível de app.json).
# Reinicie o Metro com cache limpo: npx expo start --clear

# Chat em tempo real: Socket.IO no mesmo host que esta URL (a API usa Redis para várias réplicas).
# URL base da API Nest (sem barra no fim). Exemplos:
# - Simulador iOS / Metro na mesma máquina: http://localhost:3000
# - Android emulator: http://10.0.2.2:3000
# - Telemóvel na mesma Wi‑Fi: http://192.168.x.x:3000 (IP do PC)
# - Túnel ngrok: https://xxxx.ngrok-free.dev (o app envia ngrok-skip-browser-warning)
# A chave OpenAI fica só em apps/api/.env (OPENAI_API_KEY).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Builds EAS (APK/AAB na nuvem): o .env local NÃO entra no artefacto. Crie segredo de projeto:
#   eas secret:create --scope project --name EXPO_PUBLIC_API_URL --value https://sua-api.tld
# (e o mesmo para EXPO_PUBLIC_ONESIGNAL_APP_ID se usar OneSignal).

# Push (Expo): após `eas init`, copie o project ID do projeto e exporte ao arrancar o Metro, ou
# defina em app.json → extra.eas.projectId. Ex.: EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# EAS_PROJECT_ID=

# OneSignal (opcional — se definido, o app usa OneSignal em vez de só Expo push). Dashboard → Settings → Keys & IDs
# EXPO_PUBLIC_ONESIGNAL_APP_ID=
