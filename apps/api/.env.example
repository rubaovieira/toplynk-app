PORT=3000
NODE_ENV=development

# Postgres na tua máquina (sem Docker)
# 1) No psql ou pgAdmin: CREATE DATABASE toplynk;
# 2) Ajusta utilizador/senha ao teu instalador (muitas vezes user "postgres").
# 3) Schema: na pasta apps/api, `npm run migration:run` (inclui setup_profile, chats, device_tokens para push).
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=toplynk

# Sem Postgres local — ficheiro SQLite (opcional)
# DB_DRIVER=sqlite
# SQLITE_PATH=data/toplynk.sqlite

# Limite do JSON no body (ex.: fotos base64 no cadastro). Ex.: 12mb, 20mb
# REQUEST_BODY_LIMIT=12mb

# Docker — API + Postgres + Redis (pasta apps/api):
#   cp .env.example .env   # define JWT_SECRET antes de subir
#   npm run docker:up      # ou: docker compose up -d --build
# Dentro da rede Docker o compose injeta DB_* e REDIS_URL; no .env podes ainda
# definir JWT_SECRET, OPENAI_API_KEY, REQUEST_BODY_LIMIT, etc.

# Redis — adaptador Socket.IO (chat em tempo real; várias instâncias da API partilham eventos).
# API na tua máquina com redis no compose (só postgres/redis): redis://127.0.0.1:6379
# API dentro do compose: o ficheiro docker-compose.yml define REDIS_URL=redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# JWT (login e PATCH /users/:id/profile). Em desenvolvimento podes omitir — usa fallback inseguro só em local.
# Em produção JWT_SECRET é obrigatório.
JWT_SECRET=
# TTL do access token em segundos (predefinido 7 dias)
JWT_EXPIRES_SEC=604800

# OneSignal — envio de push quando os dispositivos registam `provider: onesignal` (REST API).
# Dashboard: https://app.onesignal.com → Settings → Keys & IDs
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Entrevista IA (OpenAI só no servidor — o app chama POST /interview/turn)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_ORG_ID=org_...
# OPENAI_PROJECT_ID=proj_...
